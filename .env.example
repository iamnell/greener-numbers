# Create a beehiiv API key with the subscriptions:write permission and copy its publication ID.
# Leave unset in local development; the subscription form will show a clear configuration message.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Supabase: Project Settings -> API. The service-role key is server-only; never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Greener Numbers YouTube Data API. Keep server-only; never use NEXT_PUBLIC_ names.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UC2r0Kbi2obkGA5dgJ5kmIEQ
YOUTUBE_UPLOADS_PLAYLIST_ID=UU2r0Kbi2obkGA5dgJ5kmIEQ

# EIA Open Data API key. Server-only; used for official current electricity context and
# default rate suggestions. User-entered calculator values always override source defaults.
EIA_API_KEY=

# Phase 2 only: DOE/NREL Alternative Fuel Stations API key. Keep server-only.
NREL_API_KEY=

# Required by Vercel Cron. Generate a long random value and store it as a sensitive
# Vercel environment variable; never commit it or prefix it with NEXT_PUBLIC_.
CRON_SECRET=
